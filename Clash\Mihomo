function overwriteTunnel(params) {
    params.tun = {
        enable: OPTIONS.enableTun,
        stack: "mixed",
        device: "TUN",
        "dns-hijack": ["any:53", "tcp://any:53"],
        "auto-route": true,
        "auto-detect-interface": true,
