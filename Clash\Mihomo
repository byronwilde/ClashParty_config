// Clash/Mihomo common overwrite script, optimized version
const OPTIONS = {
    enableTun: true,
    enableSniffer: true,
    // Set true when leak prevention is more important than compatibility with game boosters/VPNs.
    strictRoute: false,
    testUrl: "https://cp.cloudflare.com/generate_204",
    // 改为 DIRECT 避免冷启动时规则集下载失败
    ruleProviderProxy: "DIRECT",
};

function main(params) {
    if (!params || !Array.isArray(params.proxies)) return params;

    const globalExcludeKeywords = /(邀请返佣|重新从网站获取订阅|公告信息|重置|套餐|剩余|网址|https?:\/\/|\.[a-z]{2,})/i;
    params.proxies = params.proxies.filter((proxy) => proxy && proxy.name && !globalExcludeKeywords.test(proxy.name));

    overwriteBasicOptions(params);
    overwriteDns(params);
    overwriteHosts(params);
    overwriteTunnel(params);
    overwriteProxyGroups(params);
    overwriteRules(params);
    return params;
}

function overwriteBasicOptions(params) {
    Object.assign(params, {
        "mixed-port": 7897,
        "allow-lan": true,
        mode: "rule",
        "log-level": "warning",
        ipv6: false,
        "find-process-mode": "off",
        profile: {
            "store-selected": true,
            "store-fake-ip": true,
        },
        "unified-delay": true,
        "tcp-concurrent": true,
        "global-client-fingerprint": "chrome",
    });

    if (OPTIONS.enableSniffer) {
        params.sniffer = {
            enable: true,
            sniff: {
                HTTP: {
                    ports: [80, "8080-8880"],
                    "override-destination": true,
                },
                TLS: {
                    ports: [443, 8443],
                    "override-destination": true,
                },
                QUIC: {
                    ports: [443, 8443],
                },
            },
            "skip-domain": [
                "+.lan",
                "+.local",
                "+.localdomain",
                "+.home.arpa",
                "+.mesh.mihome.io",
                "+.push.apple.com",
                "+.push.googleapis.com",
                "+.mtalk.google.com",
            ],
        };
    } else {
        delete params.sniffer;
    }
}

